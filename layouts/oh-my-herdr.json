{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "theme": {
    "light": "qingci",
    "dark": "xuanmo"
  },
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "terminal_menu": "inkstone-paste",
  "preview": "layouts/oh-my-herdr.png",
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 272
      },
      "min": 44,
      "max": 420,
      "background": "chrome",
      "resizable": true,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "inkstone-chrome"
          }
        },
        {
          "id": "workbench",
          "type": "block",
          "size": {
            "weight": 1
          },
          "min": 120,
          "content": {
            "mod": "inkstone-workbench"
          }
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 120
          },
          "content": {
            "mod": "inkstone-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "header",
          "type": "row",
          "size": {
            "px": 42
          },
          "resizable": false,
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "size": {
                "weight": 1
              },
              "window_drag": true,
              "content": {
                "mod": "inkstone-tabs"
              }
            }
          ]
        },
        {
          "id": "body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "panel-body",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 380
              },
              "min": 280,
              "max": 620,
              "resizable": true,
              "children": [
                {
                  "id": "panel-stack",
                  "type": "stack",
                  "active": "files",
                  "size": {
                    "weight": 1
                  },
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "inkstone-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "cockpit",
                      "type": "block",
                      "content": {
                        "mod": "cockpit"
                      }
                    },
                    {
                      "id": "sessions",
                      "type": "block",
                      "content": {
                        "mod": "inkstone-sessions"
                      }
                    },
                    {
                      "id": "favorites",
                      "type": "block",
                      "content": {
                        "mod": "inkstone-favorites"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "row",
          "size": {
            "px": 28
          },
          "background": "chrome",
          "children": [
            {
              "id": "status-text",
              "type": "block",
              "size": {
                "weight": 1
              },
              "content": {
                "mod": "workspace-status"
              }
            },
            {
              "id": "metrics",
              "type": "block",
              "size": {
                "px": 152
              },
              "content": {
                "mod": "inkstone-metrics"
              }
            },
            {
              "id": "ports",
              "type": "block",
              "size": {
                "px": 64
              },
              "content": {
                "mod": "inkstone-ports"
              }
            },
            {
              "id": "inbox",
              "type": "block",
              "size": {
                "px": 84
              },
              "content": {
                "mod": "inkstone-inbox"
              }
            },
            {
              "id": "review",
              "type": "block",
              "size": {
                "px": 88
              },
              "content": {
                "mod": "inkstone-review"
              }
            }
          ]
        }
      ]
    }
  ]
}
